      "FaceResult": {
        "additionalProperties": false,
        "description": "One detected face. ``matched`` means it passed the acceptance rules in this frame\nonly; the UI must still require stable consecutive matches before showing a name.",
        "properties": {
          "box": {
            "$ref": "#/components/schemas/Box"
          },
          "personId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Personid"
          },
          "similarity": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": -1.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cosine similarity; not a probability.",
            "title": "Similarity"
